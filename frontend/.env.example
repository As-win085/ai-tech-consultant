# Frontend configuration.
# Copy this file to `.env` (or `.env.local`) and adjust the URLs to match where
# each backend is running. `.env*` files are git-ignored.
#
# SECURITY: Never put Anthropic/OpenAI/database/API keys in VITE_* variables.
# They are bundled into the browser and are not secret. Each backend reads its
# own provider credentials from its environment.

# Task 1 — Knowledge Brain (FastAPI, default port 8000)
VITE_KNOWLEDGE_API_URL=http://localhost:8000

# Task 2 — Inbox Agent (Fastify, default port 8080)
VITE_INBOX_API_URL=http://localhost:8080

# Task 3 — Meeting-to-Scope (FastAPI, default port 8090)
VITE_MEETING_API_URL=http://localhost:8090

# Development/demo mode. When "true", the UI shows a demo banner. The real API
# clients are still used; this flag only controls explicit demo labeling so a
# production build never silently falls back to mock data.
VITE_DEMO_MODE=false
