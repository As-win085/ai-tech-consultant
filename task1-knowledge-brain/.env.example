# Task 1 — Knowledge Brain configuration.
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# Never commit real secrets.

# PostgreSQL + pgvector connection string (required for the indexing CLI, not for dry run).
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/knowledge_brain

# Embedding provider: gemini | openai_compatible | ollama
#   gemini = Google Gemini embedding endpoint; uses LLM_API_KEY below
#   openai_compatible = hosted OpenAI-compatible /embeddings endpoint
#   ollama = local Ollama OpenAI-compatible endpoint (no key required)
EMBEDDING_PROVIDER=gemini

# Required for hosted embedding providers:
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Optional. Provider-specific endpoint override.
EMBEDDING_BASE_URL=

# Optional tuning.
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT=30
EMBEDDING_MAX_RETRIES=3

# Chat provider configuration.
LLM_PROVIDER=gemini
LLM_MIN_DELAY_MS=8000
LLM_MODEL=gemini-3.8-flash
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_REQUEST_DELAY_MS=250
