# Task 1 — Knowledge Brain configuration.
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# Never commit real secrets.

# PostgreSQL + pgvector connection string (required for the indexing CLI, not for dry run).
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/knowledge_brain

# Embedding provider: fake | openai | openai_compatible | ollama
#   fake  = deterministic offline embeddings (tests / dry run only, NOT real)
#   openai/openai_compatible = a hosted OpenAI-compatible /embeddings API (key required)
#   ollama = a local Ollama server's OpenAI-compatible endpoint (no key required)
EMBEDDING_PROVIDER=fake

# Required for openai / openai_compatible / ollama:
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=

# Required for openai / openai_compatible; optional for ollama.
EMBEDDING_API_KEY=

# Optional. Defaults: openai -> https://api.openai.com/v1, ollama -> http://localhost:11434/v1
EMBEDDING_BASE_URL=

# Optional tuning.
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT=30
EMBEDDING_MAX_RETRIES=3
