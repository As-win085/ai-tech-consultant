# Task 3 — Meeting-to-Scope configuration.
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# Never commit real secrets.

# --- HTTP server ---
PORT=8090
LOG_LEVEL=info

# --- Task 1 Knowledge Brain (feasibility checks) ---
# Task 3 calls this API; it never re-implements retrieval or answer generation.
KNOWLEDGE_BRAIN_URL=http://localhost:8000
KNOWLEDGE_BRAIN_TIMEOUT_MS=60000
KNOWLEDGE_BRAIN_RETRIES=1

# --- Requirement extraction engine ---
# rules = deterministic, offline (default); llm = external chat model
EXTRACTOR=rules

# --- LLM provider (only used when EXTRACTOR=llm) ---
# provider: gemini | groq | openrouter | ollama | anthropic | openai_compatible
LLM_PROVIDER=gemini
LLM_MIN_DELAY_MS=8000
LLM_MODEL=gemini-3.8-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_REQUEST_DELAY_MS=250
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=1
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.0

# --- Transcript ingestion ---
# Directory scanned by the CLI seed/demo command (relative to CWD).
TRANSCRIPT_DIR=data/transcripts
# Reject transcripts whose combined segment text exceeds this many characters.
MAX_TRANSCRIPT_CHARS=200000

# --- Persistence (PostgreSQL) ---
# If unset, an in-memory store is used (not durable; for tests/dev only).
DATABASE_URL=
# Isolated schema so Task 3 never collides with Task 1 tables.
DATABASE_SCHEMA=meeting_to_scope
