# Task 2 Inbox Agent configuration (placeholders only; never commit a real .env)

PORT=8080
LOG_LEVEL=info

# Bind address. Leave empty to auto-probe "::" (dual-stack) then "0.0.0.0".
# Set HOST=0.0.0.0 on platforms without IPv6.
HOST=
# Set to true when running behind a reverse proxy / TLS terminator
# (Render, Fly, nginx) so X-Forwarded-For is honoured.
TRUST_PROXY=false
# Comma-separated browser origins allowed by CORS. localhost:5173 is always
# allowed. A single "*" or wildcards such as https://*.vercel.app are supported.
ALLOWED_ORIGINS=

# Task 1 Knowledge Brain API
KNOWLEDGE_BRAIN_URL=http://localhost:8000
KNOWLEDGE_BRAIN_TIMEOUT_MS=30000
KNOWLEDGE_BRAIN_RETRIES=2

# Classification engine: "rules" (deterministic, offline) or "llm"
CLASSIFIER=rules
# When CLASSIFIER=llm:
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
LLM_BASE_URL=
LLM_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
LLM_TIMEOUT_MS=60000
LLM_RETRIES=1
LLM_MIN_DELAY_MS=8000
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EVAL_MODEL_CHEAP=gemini-3.1-flash-lite
EVAL_MODEL_STRONG=gemini-3.8-flash

# Human-review automation trigger (20 consecutive unedited approvals -> automation-ELIGIBLE only)
MAX_CONSECUTIVE_UNEDITED_APPROVALS=20

# Persistence (PostgreSQL). If unset, an in-memory store is used (not durable).
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/knowledge_brain
DATABASE_SCHEMA=inbox_agent

# Demo dataset auto-loaded on startup
EMAIL_DATASET_PATH=datasets/emails-sample.json
