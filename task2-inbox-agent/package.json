{
  "name": "inbox-agent",
  "version": "0.1.0",
  "description": "Inbox Agent (Task 2) — email classification, grounding via Task 1 Knowledge Brain, human review",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "ts-node src/server.ts",
    "dev": "ts-node src/server.ts",
    "test": "jest --runInBand --cacheDirectory ./.jest-cache",
    "test:watch": "jest --maxWorkers=2 --watch",
    "test:integration": "jest --runInBand --cacheDirectory ./.jest-cache --testPathPattern=integration",
    "evals": "ts-node evals/runEvals.ts",
    "evals:holdout": "ts-node evals/runHoldout.ts"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "pg": "^8.13.1",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.venv",
      "<rootDir>/dist",
      "<rootDir>/node_modules"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json",
          "diagnostics": false
        }
      ]
    }
  }
}
